<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/btnBack"
                android:background="@android:color/transparent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#00aaff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/timecompare_title"
                android:layout_weight="1"
                android:paddingStart="12dp"/>
        </LinearLayout>

        <TextView
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/timecompare_intro"/>

        <LinearLayout
            android:id="@+id/cardPickA"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/btn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginBottom="10dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">
            <TextView
                android:textSize="22sp"
                android:gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="1️⃣"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timecompare_pick_a"/>
                <TextView
                    android:id="@+id/tvFileA"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timecompare_no_file"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cardPickB"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/btn_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:layout_marginBottom="14dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">
            <TextView
                android:textSize="22sp"
                android:gravity="center"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="2️⃣"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timecompare_pick_b"/>
                <TextView
                    android:id="@+id/tvFileB"
                    android:textSize="12sp"
                    android:textColor="#888888"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/timecompare_no_file"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/btnCompare"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/btn_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:enabled="false"
            android:alpha="0.5"
            android:text="@string/timecompare_run"/>

        <LinearLayout
            android:id="@+id/resultsContainer"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="18dp">

            <LinearLayout
                android:id="@+id/captureContainer"
                android:orientation="vertical"
                android:background="#1a1a1a"
                android:padding="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvSummary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:paddingBottom="4dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/tvAlignment"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <com.geoscanner.app.compare.DiffMapView
                    android:id="@+id/diffMapView"
                    android:layout_width="match_parent"
                    android:layout_height="280dp"/>

                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#1E5BFF"/>
                        <TextView android:textSize="11sp" android:textColor="#cccccc" android:paddingStart="6dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/timecompare_legend_decrease"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingEnd="16dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#3A3A3A"/>
                        <TextView android:textSize="11sp" android:textColor="#cccccc" android:paddingStart="6dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/timecompare_legend_unchanged"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <View android:layout_width="12dp" android:layout_height="12dp" android:background="#FF3B1F"/>
                        <TextView android:textSize="11sp" android:textColor="#cccccc" android:paddingStart="6dp"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/timecompare_legend_increase"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/btnMode2D"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/timecompare_mode_2d"/>
                <TextView
                    android:id="@+id/btnMode3D"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/grid_cell"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="10dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/timecompare_mode_3d"/>
            </LinearLayout>

            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#00aaff"
                android:paddingTop="18dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/timecompare_regions_title"/>

            <LinearLayout
                android:id="@+id/regionsContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/btnExportPng"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:layout_marginEnd="6dp"
                    android:text="@string/timecompare_export_png"/>
                <TextView
                    android:id="@+id/btnExportPdf"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="12dp"
                    android:layout_marginStart="6dp"
                    android:text="@string/timecompare_export_pdf"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
