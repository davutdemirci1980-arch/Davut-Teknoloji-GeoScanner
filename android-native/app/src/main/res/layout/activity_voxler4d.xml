<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/topBar"
        android:background="#cc000000"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btnBack"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="↩"/>
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp">
                <Button
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnScatter"
                    android:background="#3300aaff"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/voxler_scatter"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="12dp"/>
                <Button
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnIsoSurface"
                    android:background="#3300aaff"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/voxler_isosurface"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="12dp"/>
                <Button
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnVolume"
                    android:background="#3300aaff"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/voxler_volume"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="12dp"/>
                <Button
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnHeightField"
                    android:background="#3300aaff"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/voxler_heightfield"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="12dp"/>
                <Button
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#ffffff"
                    android:id="@+id/btnContours"
                    android:background="#3300aaff"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="@string/voxler_contours"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="12dp"/>
            </LinearLayout>
        </HorizontalScrollView>
        <Button
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:id="@+id/btnLayers"
            android:background="#33ffd700"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/voxler_layers"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="10dp"/>
        <Button
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ff6600"
            android:id="@+id/btnFilters"
            android:background="#33ff6600"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/voxler_filters"
            android:layout_marginEnd="4dp"
            android:paddingHorizontal="10dp"/>
        <Button
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#00ff88"
            android:id="@+id/btnTools"
            android:background="#3300ff88"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/voxler_tools"
            android:paddingHorizontal="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:id="@+id/bottomBar"
        android:background="#cc000000"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#00aaff"
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="4D Voxler Pro"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:id="@+id/tvRenderMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scatter"
            android:paddingHorizontal="8dp"/>
        <TextView
            android:textSize="11sp"
            android:textColor="#ff6600"
            android:id="@+id/tvFilter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:paddingHorizontal="8dp"/>
    </LinearLayout>
</FrameLayout>
