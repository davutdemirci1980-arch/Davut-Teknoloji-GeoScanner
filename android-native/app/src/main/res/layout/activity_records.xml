<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:paddingTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="@android:color/transparent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00aaff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/records_title"
            android:layout_weight="1"
            android:paddingStart="12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:paddingBottom="8dp">
        <TextView
            android:id="@+id/btnExportZip"
            android:background="@drawable/btn_card"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:text="@string/records_export_zip"/>
        <TextView
            android:id="@+id/btnImportZip"
            android:background="@drawable/btn_card"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="#ffffff"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:text="@string/records_import_zip"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#666666"
        android:gravity="center"
        android:id="@+id/tvEmpty"
        android:padding="40dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/records_empty"/>
    <ListView
        android:id="@+id/listRecords"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:divider="#333333"
        android:dividerHeight="1dp"
        android:layout_weight="1"/>
</LinearLayout>
