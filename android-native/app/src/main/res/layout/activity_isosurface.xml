<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="#111111"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageButton
                android:id="@+id/btnBack"
                android:background="@android:color/transparent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_revert"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:id="@+id/btnSurface"
                android:background="@drawable/btn_card"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:text="@string/iso_surface"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="4dp"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ff6b00"
                android:id="@+id/btnIsoSurface"
                android:background="@drawable/btn_card"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:text="@string/iso_isosurface"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:layout_marginHorizontal="4dp"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00ff00"
                android:id="@+id/btnPointCloud"
                android:background="@drawable/btn_card"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:text="@string/iso_points"
                android:layout_weight="1"
                android:textAllCaps="true"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="44dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iso_interp_label"
                android:paddingEnd="10dp"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#ffd700"
                android:id="@+id/btnInterp"
                android:background="@drawable/btn_card"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:minWidth="160dp"
                android:text="@string/iso_interp_gaussian"
                android:textAllCaps="false"
                android:drawableEnd="@android:drawable/arrow_down_float"
                android:paddingHorizontal="20dp"/>
        </LinearLayout>
    </LinearLayout>
    <WebView
        android:id="@+id/webView3D"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
