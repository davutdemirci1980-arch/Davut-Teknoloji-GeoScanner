<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:paddingTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="@android:color/transparent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#00aaff"
            android:gravity="center"
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/scan_ready"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#ff6b00"
            android:id="@+id/tvProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 0"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#00ff00"
            android:id="@+id/tvCurrentValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0.0"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#888888"
            android:id="@+id/tvPosition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/scan_ready"/>
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <GridLayout
                android:layout_gravity="center"
                android:id="@+id/gridLayout"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="13sp"
            android:textColor="#ffff00"
            android:id="@+id/btnCalibrate"
            android:background="@drawable/btn_card"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/scan_calibrate"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btnRecord"
            android:background="@drawable/btn_primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/scan_record"
            android:layout_weight="2"
            android:layout_marginHorizontal="4dp"/>
        <Button
            android:textSize="13sp"
            android:textColor="#00ff00"
            android:id="@+id/btnFinish"
            android:background="@drawable/btn_card"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="@string/scan_finish"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
