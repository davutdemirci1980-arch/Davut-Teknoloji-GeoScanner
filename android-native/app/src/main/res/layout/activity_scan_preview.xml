<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#111111"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:paddingTop="32dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="@android:color/transparent"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_revert"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#00aaff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/preview_title"
            android:layout_weight="1"
            android:paddingStart="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="#888888"
        android:id="@+id/tvInfo"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_loading"
        android:paddingHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/btn_card"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#888888"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_intensity"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#00aaff"
                android:id="@+id/tvIntensity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/btn_card"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#888888"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_depth"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ff6b00"
                android:id="@+id/tvDepth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/btn_card"
            android:padding="6dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp">
            <TextView
                android:textSize="10sp"
                android:textColor="#888888"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_coords"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#00ff00"
                android:id="@+id/tvCoords"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/ivHeatmap"
        android:background="#1a1a1a"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scaleType="fitCenter"
        android:layout_weight="1"/>
    <TextView
        android:textSize="11sp"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_touch_hint"
        android:paddingVertical="4dp"/>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/preview_export_options"
        android:paddingHorizontal="16dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <Button
            android:textSize="11sp"
            android:textColor="#00aaff"
            android:id="@+id/btnExportVTK"
            android:background="@drawable/btn_card"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/preview_btn_vtk"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="11sp"
            android:textColor="#ff6b00"
            android:id="@+id/btnExportGRD"
            android:background="@drawable/btn_card"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/preview_btn_grd"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"/>
        <Button
            android:textSize="11sp"
            android:textColor="#00ff00"
            android:id="@+id/btnExportCSV"
            android:background="@drawable/btn_card"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:text="@string/preview_btn_csv"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp">
        <Button
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:id="@+id/btn3DView"
            android:background="@drawable/btn_primary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/preview_btn_3d"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#ffd700"
            android:id="@+id/btn4DVoxler"
            android:background="@drawable/btn_primary"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/main_4d_voxler"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
