<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="#111111"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/btnBack"
            android:background="@android:color/transparent"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_revert"
            android:contentDescription="Back"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#00aaff"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/setup_title"
            android:layout_weight="1"
            android:paddingStart="12dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="#aaaaaa"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setup_scan_name"/>
    <EditText
        android:textSize="16sp"
        android:textColor="#ffffff"
        android:textColorHint="#555555"
        android:id="@+id/etScanName"
        android:background="@drawable/grid_cell"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:hint="Enter scan name"
        android:inputType="text"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:id="@+id/tvGridWidth"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setup_scan_name"/>
    <SeekBar
        android:id="@+id/sbGridWidth"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:progressTint="#00aaff"
        android:thumbTint="#00aaff"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:id="@+id/tvGridHeight"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setup_scan_name"/>
    <SeekBar
        android:id="@+id/sbGridHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:progressTint="#00aaff"
        android:thumbTint="#00aaff"/>
    <TextView
        android:textSize="15sp"
        android:textColor="#ffffff"
        android:id="@+id/tvStepSize"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/setup_scan_name"/>
    <SeekBar
        android:id="@+id/sbStepSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:progressTint="#ff6b00"
        android:thumbTint="#ff6b00"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <Button
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:id="@+id/btnStartScan"
        android:background="@drawable/btn_primary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/setup_start"/>
</LinearLayout>
